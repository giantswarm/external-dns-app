diff --git a/helm/external-dns-app/templates/crds/rbac.yaml b/helm/external-dns-app/templates/crds/rbac.yaml
new file mode 100644
index 0000000..ad83e1d
--- /dev/null
+++ b/helm/external-dns-app/templates/crds/rbac.yaml
@@ -0,0 +1,39 @@
+{{- if .Values.crd.install }}
+apiVersion: rbac.authorization.k8s.io/v1
+kind: ClusterRole
+metadata:
+  name: {{ include "external-dns.crdInstaller.name" . }}
+  annotations:
+    {{- include "external-dns.crdInstaller.annotations" . | nindent 4 }}
+    "helm.sh/hook-weight": "-3"
+  labels:
+    {{- include "external-dns.crdInstaller.labels" . | nindent 4 }}
+rules:
+- apiGroups:
+  - apiextensions.k8s.io
+  resources:
+  - customresourcedefinitions
+  verbs:
+  - create
+  - get
+  - patch
+  - update
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: ClusterRoleBinding
+metadata:
+  name: {{ include "external-dns.crdInstaller.name" . }}
+  annotations:
+    {{- include "external-dns.crdInstaller.annotations" . | nindent 4 }}
+    "helm.sh/hook-weight": "-2"
+  labels:
+    {{- include "external-dns.crdInstaller.labels" . | nindent 4 }}
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: ClusterRole
+  name: {{ include "external-dns.crdInstaller.name" . }}
+subjects:
+- kind: ServiceAccount
+  name: {{ include "external-dns.crdInstaller.name" . }}
+  namespace: {{ include "external-dns.namespace" . }}
+{{- end }}
